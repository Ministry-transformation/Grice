---
import GravisLayout from '../../layouts/GravisLayout.astro';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const facts=[['▦','12 березня 1970','Дата народження'],['⌖','Київ, Україна','Рідне місто'],['▤','Інженер','Професія'],['♡','Чоловік, батько, друг','Найважливіші ролі']];
const moments: [string,number,string,string][]=[
  ['1970',0,'Народження','12 березня 1970 року в Києві.'],
  ['1995',1,'Створення родини','Одруження з коханою та початок спільного шляху.'],
  ['2000',2,'Батьківство','Найбільше щастя — бути татом.'],
  ['2010+',3,'Подорожі','Відкривав нові місця й надихав інших.'],
];
const photos: [number,string,string][]=[
  [2,'Олександр із родиною','2017'],[3,'Карпатська мандрівка','2019'],[1,'Весільний день','1995'],[0,'Спогад із дитинства','1970'],[4,'Вірний друг','2021'],[5,'Ранкова кава','2022'],
];
---
<GravisLayout title="Олександр Іванович Коваленко — сторінка пам’яті | Gravis" description="Історія життя, світлини та спогади про Олександра Івановича Коваленка.">
  <main class="memorial">
    <section class="m-hero"><header class="g-header m-header"><a class="g-brand" href={`${basePath}/`} aria-label="Gravis — на головну"><span class="g-mark">G<i></i></span><span>Gravis</span></a><nav aria-label="Навігація сторінкою"><a href="#story">Пам’ять</a><a href={`${basePath}/`}>Про нас</a><a href="#photos">Наші фото</a><a href="#memories">Спогади рідних</a><a href="#media">Медіа</a><a href="#remember">Контакти</a></nav><div class="g-header-actions"><span class="g-locale" aria-label="Мова сайту: українська">◎ <span>UA</span></span><a class="g-header-cta" href="#remember">Залишити спогад <span>→</span></a><button class="g-menu" aria-label="Відкрити меню" aria-expanded="false">☰</button></div></header><img class="m-hero-photo" src={`${basePath}/images/portrait.webp`} alt="Олександр Коваленко серед Карпатських гір"/><div class="m-hero-shade"></div><div class="m-hero-content wrap"><p class="g-kicker">СВІТЛА ПАМ’ЯТЬ</p><h1>Олександр Іванович<br/>Коваленко</h1><p class="m-years">1970 — 2023</p><p class="m-quote">Добра людина живе<br/>у спогадах назавжди.</p></div><p class="m-side-note">Людина, яка робила світ навколо себе кращим.</p></section>
    <section class="m-story m-light" id="story"><div class="wrap m-story-layout"><div class="m-biography"><div class="m-section-title"><h2>Історія життя</h2><span></span></div><p>Олександр Іванович Коваленко народився 12 березня 1970 року в Києві. Був турботливим сином, люблячим чоловіком, уважним батьком і справжнім другом. Усе життя він залишався вірним своїм цінностям — чесності, доброті та повазі до людей.</p><p>Працював інженером, захоплювався подорожами, природою та фотографією. Завжди знаходив час для родини, підтримував близьких і надихав своїм прикладом.</p><a class="g-button" href="#timeline">Більше про життя <span>→</span></a></div><dl class="m-facts">{facts.map(([icon,value,label])=><div><dt><span aria-hidden="true">{icon}</span></dt><dd><b>{value}</b><small>{label}</small></dd></div>)}</dl><figure class="m-polaroid"><div class="m-polaroid-window"><img src={`${basePath}/images/memory-0.webp`} alt="Архівне фото Олександра з дитиною" loading="lazy"/></div><figcaption>Найцінніше — це люди поруч.</figcaption></figure></div></section>
    <section class="m-timeline" id="timeline"><div class="wrap"><div class="m-section-title light-title"><h2>Важливі моменти</h2><span></span><a href="#timeline">Усі події життя <b>→</b></a></div><ol class="m-timeline-line">{moments.map(([year,image,title,desc])=><li><span class="m-dot"></span><small class="m-year">{year}</small><div class="m-timeline-image"><img src={`${basePath}/images/memory-${image}.webp`} alt="" loading="lazy"/></div><h3>{title}</h3><p>{desc}</p></li>)}</ol></div></section>
    <section class="m-photos m-light" id="photos"><div class="wrap"><div class="m-section-title"><h2>Фотоархів</h2><span></span><a href="#photos">Усі фото <b>→</b></a></div><div class="m-photo-rail"><div class="m-photo-grid">{photos.map(([image,caption,year],i)=><button class="m-photo" data-photo={i} data-photo-src={`${basePath}/images/memory-${image}.webp` } data-caption={caption} data-year={year} aria-label={`Відкрити фото: ${caption}`}><span class="m-photo-window"><img src={`${basePath}/images/memory-${image}.webp`} alt={caption} loading="lazy"/></span><span class="m-photo-caption">{caption}<small>{year}</small></span></button>)}</div><div class="m-rail-controls"><button class="m-rail-prev" aria-label="Попередні фото">←</button><button class="m-rail-next" aria-label="Наступні фото">→</button></div></div></div></section>
    <section class="m-media m-light" id="media"><div class="wrap"><div class="m-media-header"><h2>Медіа</h2><div class="m-media-tabs" role="group" aria-label="Тип медіа"><button class="active" aria-pressed="true" data-media-tab="video">▷ &nbsp; Відео</button><button aria-pressed="false" data-media-tab="audio">⌁ &nbsp; Аудіо</button><button aria-pressed="false" data-media-tab="voice">♩ &nbsp; Голос</button></div><a href="#media">Усі медіа <b>→</b></a></div><div class="m-media-grid"><article class="m-media-card m-video"><span class="m-media-image m-video-image"><img src={`${basePath}/images/memory-3.webp`} alt="Карпатська мандрівка Олександра" loading="lazy"/></span><button class="m-play" data-media="Подорож Карпатами" aria-label="Відкрити відео: Подорож Карпатами">▷</button><div><small>ПОДОРОЖ КАРПАТАМИ</small><time>03:24</time></div></article><article class="m-media-card m-audio"><span class="m-media-image"><img src={`${basePath}/images/memory-5.webp`} alt="Ранкова кава та світло біля вікна" loading="lazy"/></span><button class="m-play" data-media="Улюблена музика" aria-label="Відкрити аудіо: Улюблена музика">▷</button><div><small>УЛЮБЛЕНА МУЗИКА</small><p>Плейлист, який завжди був поруч.</p><span class="m-wave" aria-hidden="true">▂ ▄ ▆ ▃ ▇ ▄ ▂ ▅ ▆ ▃ ▄ ▇ ▂ ▅ ▄ ▆</span></div><time>12:36</time></article><article class="m-media-card m-voice"><span class="m-media-image"><img src={`${basePath}/images/memory-2.webp`} alt="Олександр поруч із родиною" loading="lazy"/></span><button class="m-play" data-media="Його голос" aria-label="Відкрити запис голосу">▷</button><div><small>ЙОГО ГОЛОС</small><p>Кілька теплих слів для найрідніших.</p><span class="m-wave" aria-hidden="true">▃ ▅ ▂ ▆ ▃ ▅ ▂ ▄ ▇ ▃ ▄ ▆ ▂ ▅ ▃ ▇</span></div><time>01:18</time></article></div></div></section>
    <section class="m-memories" id="memories"><div class="wrap"><div class="m-section-title"><h2>Спогади рідних</h2><span></span><a href="#memories">Усі спогади <b>→</b></a></div><div class="m-memory-grid"><article><blockquote>«Він завжди вмів підтримати, знайти правильні слова і зробити складний день легшим. Для нас він був і залишається прикладом сили, доброти та гідності.»</blockquote><div><i>ОК</i><p><b>Олена Коваленко</b><small>Дружина</small></p></div></article><article><blockquote>«Тато навчив мене бути чесним, не боятися мріяти і завжди йти до кінця. Його віра в мене — це те, що я відчуваю й сьогодні.»</blockquote><div><i>МК</i><p><b>Максим Коваленко</b><small>Син</small></p></div></article><article><blockquote>«Він був тим другом, на якого завжди можна було покластися. Завжди спокійний, мудрий, з добрим серцем і щирою усмішкою.»</blockquote><div><i>АП</i><p><b>Андрій Петренко</b><small>Друг</small></p></div></article></div></div></section>
    <section class="m-poem"><div class="wrap m-poem-layout"><div><p class="g-kicker">СЛОВА, ЩО ЛИШАЮТЬСЯ</p><h2>Улюблені рядки</h2><blockquote>«Подорожуй. Бо найкращі історії народжуються не в комфорті, а в дорозі.»</blockquote><span>— Олександр Коваленко</span></div><div class="m-notebook" aria-label="Запис у блокноті"><span>✦</span><p>Життя — це не чекати,<br/>поки мине гроза, а вчитися<br/>танцювати під дощем.</p></div></div></section>
    <section class="m-closing" id="remember" style={`--closing-image:url("${basePath}/images/memory-5.webp")`}><div class="wrap m-closing-row"><div><h2>Пам’ять, яка живе</h2><p>Тут зібрані спогади, які назавжди залишають Олександра з нами. Поділіться своїми спогадами, світлинами або теплими словами.</p></div><button class="g-button outline" data-open-memory>♡ &nbsp; Залишити спогад <span>→</span></button></div></section>
  </main>
  <dialog class="m-dialog" aria-labelledby="memory-title"><form class="m-form"><button type="button" class="m-close" aria-label="Закрити">×</button><p class="g-kicker dark">ВАШІ СЛОВА МАЮТЬ ЗНАЧЕННЯ</p><h2 id="memory-title">Залишити <i>спогад</i></h2><p class="m-form-intro">Цей локальний перегляд не надсилає й не зберігає текст.</p><label>Ваше ім’я<input required name="name" autocomplete="name" placeholder="Як до вас звертатися"/></label><label>Ким ви йому доводитесь?<input name="relationship" placeholder="Наприклад, друг, колега"/></label><label>Ваш спогад<textarea required name="message" rows="4" placeholder="Розкажіть те, що хочете зберегти"></textarea></label><button class="g-button" value="send">Переглянути спогад <span>→</span></button><small class="m-local-note">Текст показується лише тут і не передається чи не зберігається.</small></form></dialog>
  <dialog class="m-lightbox" aria-label="Перегляд світлини"><button class="m-lightbox-close" aria-label="Закрити">×</button><button class="m-lightbox-prev" aria-label="Попереднє фото">←</button><div class="m-lightbox-window"><img class="m-lightbox-img" alt=""/></div><p></p><button class="m-lightbox-next" aria-label="Наступне фото">→</button></dialog>
  <dialog class="m-media-dialog"><form method="dialog"><button class="m-close" aria-label="Закрити">×</button><p class="g-kicker dark">МЕДІААРХІВ</p><h2 class="m-media-title">Збережений момент</h2><p class="m-form-intro">До сторінки можна додати відео, музику та голосові записи.</p><button class="g-button">Повернутися до історії</button></form></dialog>
  <script>
    const menu=document.querySelector<HTMLButtonElement>('.g-menu');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));document.querySelector('.m-header nav')?.classList.toggle('nav-open',open)});
    const memoryDialog=document.querySelector<HTMLDialogElement>('.m-dialog');memoryDialog?.querySelector<HTMLButtonElement>('.m-close')?.addEventListener('click',()=>memoryDialog.close());document.querySelectorAll<HTMLButtonElement>('[data-open-memory]').forEach(button=>button.addEventListener('click',()=>memoryDialog?.showModal()));
    memoryDialog?.querySelector<HTMLFormElement>('form')?.addEventListener('submit',(event:SubmitEvent)=>{const form=event.currentTarget as HTMLFormElement;if((event.submitter as HTMLButtonElement|null)?.value==='send'){event.preventDefault();const name=(form.elements.namedItem('name') as HTMLInputElement).value.trim();const relationship=(form.elements.namedItem('relationship') as HTMLInputElement).value.trim();const message=(form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();const close=document.createElement('button');close.type='button';close.className='m-close';close.setAttribute('aria-label','Закрити');close.textContent='×';close.addEventListener('click',()=>memoryDialog.close());const title=document.createElement('h2');title.textContent='Дякуємо за спогад';const quote=document.createElement('blockquote');quote.className='m-preview-quote';quote.textContent=message;const byline=document.createElement('p');byline.className='m-form-intro';byline.textContent=[name,relationship].filter(Boolean).join(' · ');const note=document.createElement('small');note.className='m-local-note';note.textContent='Це лише попередній перегляд. Текст не надсилається й не зберігається.';form.replaceChildren(close,title,quote,byline,note)}});
    const photoData=Array.from(document.querySelectorAll<HTMLButtonElement>('.m-photo')).map(button=>({src:button.dataset.photoSrc,caption:button.dataset.caption,year:button.dataset.year,tile:Number(button.dataset.photoTile??0)}));const box=document.querySelector<HTMLDialogElement>('.m-lightbox');let active=0;
    function showPhoto(index:number){active=(index+photoData.length)%photoData.length;const item=photoData[active];const image=box!.querySelector<HTMLImageElement>('.m-lightbox-img')!;image.src=item.src??'';image.alt=item.caption??'';box!.querySelector('p')!.textContent=[item.caption,item.year].filter(Boolean).join(' · ')}
    document.querySelectorAll<HTMLButtonElement>('.m-photo').forEach((button,index)=>button.addEventListener('click',()=>{showPhoto(index);box?.showModal()}));box?.querySelector<HTMLButtonElement>('.m-lightbox-prev')?.addEventListener('click',()=>showPhoto(active-1));box?.querySelector<HTMLButtonElement>('.m-lightbox-next')?.addEventListener('click',()=>showPhoto(active+1));box?.querySelector<HTMLButtonElement>('.m-lightbox-close')?.addEventListener('click',()=>box.close());
    const rail=document.querySelector<HTMLElement>('.m-photo-grid');document.querySelector('.m-rail-prev')?.addEventListener('click',()=>rail?.scrollBy({left:-rail.clientWidth*.7,behavior:'smooth'}));document.querySelector('.m-rail-next')?.addEventListener('click',()=>rail?.scrollBy({left:rail.clientWidth*.7,behavior:'smooth'}));
    document.querySelectorAll<HTMLButtonElement>('[data-media-tab]').forEach(tab=>tab.addEventListener('click',()=>{document.querySelectorAll('[data-media-tab]').forEach(other=>{other.classList.remove('active');other.setAttribute('aria-pressed','false')});tab.classList.add('active');tab.setAttribute('aria-pressed','true')}));const mediaDialog=document.querySelector<HTMLDialogElement>('.m-media-dialog');document.querySelectorAll<HTMLButtonElement>('.m-play').forEach(button=>button.addEventListener('click',()=>{const title=mediaDialog?.querySelector('.m-media-title');if(title)title.textContent=button.dataset.media??'Збережений момент';mediaDialog?.showModal()}));
  </script>
</GravisLayout>


