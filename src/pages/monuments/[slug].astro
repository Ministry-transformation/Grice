---
import GravisLayout from '../../layouts/GravisLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import { monumentConcepts } from '../../data/modules';
import { monumentOrderFormUrl } from '../../data/contact';
export function getStaticPaths() { return monumentConcepts.map((concept) => ({ params: { slug: concept.slug }, props: { concept } })); }
const { concept } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const conceptFaqs = [
  { question: 'Чи відповідає зображення готовому виробу?', answer: 'Ні, це ілюстративний напрямок. Точна форма, матеріал, розміри та комплектація погоджуються окремо.' },
  { question: 'Від чого залежить вартість пам’ятника?', answer: 'Вартість можна визначити після уточнення матеріалу, розмірів, напису, оформлення, монтажу та інших потрібних робіт.' },
  { question: 'Як обговорити цей варіант?', answer: 'Залиште коротку заявку або заповніть детальну Google Форму. Додайте побажання щодо місця, матеріалу й напису, якщо вже маєте ці дані.' },
];
---
<GravisLayout title={`${concept.name} — форма пам’ятника у Крижополі | Gravis`} description={`${concept.form}: концепція гранітного пам’ятника для обговорення у Крижополі. Форма, матеріал, розміри й вартість погоджуються окремо.`} canonical={`/monuments/${concept.slug}`} breadcrumbs={[{ name: 'Пам’ятники', url: `${base}/monuments` }]} socialImage={concept.image} faqs={conceptFaqs}>
  <a class="skip-link" href="#main-content">Перейти до змісту</a>
  <header class="g-header g-service-header module-header"><a class="g-brand" href={`${base}/`} aria-label="Gravis — на головну"><span class="g-mark">G<i></i></span><span>Gravis</span></a><nav aria-label="Головна навігація"><a href={`${base}/monuments`}>Пам’ятники</a><a href={`${base}/stones`}>Камінь</a><a href={`${base}/artwork`}>Оформлення</a><a href={`${base}/works`}>Концепції</a></nav><div class="g-header-actions"><a class="g-header-cta" href={`${base}/contact#request`}>Обговорити <span>→</span></a></div></header>
  <main class="module-page" id="main-content"><section class="module-detail-hero wrap"><div><a class="module-back dark-link" href={`${base}/monuments`}>← До напрямків</a><p class="g-kicker dark">КОНЦЕПТУАЛЬНИЙ НАПРЯМОК</p><h1>{concept.name}</h1><p>{concept.form}. Зображення є ілюстрацією задуму, а не фото виконаного замовлення чи обіцянкою конкретної комплектації.</p><a class="g-button" href="#request">Обговорити напрямок <span aria-hidden="true">↓</span></a></div><figure><img src={`${base}/images/${concept.image}`} alt={concept.alt} width="800" height="800" fetchpriority="high"/><figcaption>Ілюстративна концепція · не фото реального проєкту</figcaption></figure></section>
  <section class="module-process"><div class="wrap"><div class="module-title"><p class="g-kicker">ДЛЯ РОЗРАХУНКУ</p><h2>Що потрібно уточнити</h2></div><div class="module-step-grid"><article><span>01</span><h3>Матеріал і розміри</h3><p>Точні сорти, габарити й наявність не задані в концепції та підтверджуються окремо.</p></article><article><span>02</span><h3>Напис і оформлення</h3><p>Погодьте текст, портрет і символи до початку робіт.</p></article><article><span>03</span><h3>Місце та роботи</h3><p>Вкажіть локацію й потребу у встановленні чи благоустрої.</p></article></div></div></section>
  <section class="module-faq wrap" aria-labelledby="concept-faq-title"><div class="module-title"><p class="g-kicker dark">ВІДПОВІДІ</p><h2 id="concept-faq-title">Запитання про концепцію</h2></div><div>{conceptFaqs.map((faq) => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div></section>
  <section class="module-faq wrap" aria-labelledby="concept-faq-title"><div class="module-title"><p class="g-kicker dark">ВІДПОВІДІ</p><h2 id="concept-faq-title">Запитання про концепцію</h2></div><div><details><summary>Чи відповідає зображення готовому виробу?<span aria-hidden="true">+</span></summary><p>Ні, це ілюстративний напрямок. Точна форма, матеріал, розміри та комплектація погоджуються окремо.</p></details><details><summary>Від чого залежить вартість пам’ятника?<span aria-hidden="true">+</span></summary><p>Вартість можна визначити після уточнення матеріалу, розмірів, напису, оформлення, монтажу та інших потрібних робіт.</p></details><details><summary>Як обговорити цей варіант?<span aria-hidden="true">+</span></summary><p>Залиште коротку заявку або заповніть детальну Google Форму. Додайте побажання щодо місця, матеріалу й напису, якщо вже маєте ці дані.</p></details></div></section>
  <section class="module-contact" id="request"><div class="wrap module-contact-layout"><div><p class="g-kicker">НАСТУПНИЙ КРОК</p><h2>Запит щодо концепції</h2><p>Коротко залиште контакт або заповніть детальну форму для прорахунку пам’ятника.</p><a class="g-button g-form-choice-button" href={monumentOrderFormUrl} target="_blank" rel="noopener noreferrer">Детальний прорахунок пам’ятника <span>↗</span></a></div><LeadForm serviceName={`Концепція «${concept.name}»`} compact /></div></section></main>
  <footer class="module-footer"><div class="wrap"><a class="g-brand" href={`${base}/`}><span class="g-mark">G<i></i></span><span>Gravis</span></a><nav><a href={`${base}/monuments`}>Каталог напрямків</a><a href={`${base}/contact`}>Контакт</a><a href={`${base}/`}>Головна</a></nav><small>© {new Date().getFullYear()} Gravis · Концептуальне зображення</small></div></footer>
</GravisLayout>
