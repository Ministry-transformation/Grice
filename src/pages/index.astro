---
import GravisLayout from '../layouts/GravisLayout.astro';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const services = [
  ['Пам’ятники з граніту','Класичні та сучасні рішення з натурального граніту.'],
  ['Художнє оформлення','Унікальний дизайн і символічні елементи.'],
  ['Портрети та написи','Професійне гравіювання портретів, написів і зображень.'],
  ['Встановлення','Якісний монтаж із дотриманням усіх стандартів.'],
  ['Благоустрій','Комплексне оформлення місць поховання.'],
  ['QR-сторінка пам’яті','Цифрова сторінка з фото, відео, спогадами та історією життя.'],
];
const capabilities = [
  ['<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>','Фото'],
  ['<circle cx="12" cy="12" r="9"/><path d="m10 8 6 4-6 4z"/>','Відео'],
  ['<path d="M2 12h3l2-7 4 14 3-10 2 3h6"/>','Аудіо'],
  ['<rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0M12 19v3m-4 0h8"/>','Голос'],
  ['<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/>','Історія життя'],
  ['<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/>','Спогади'],
  ['<path d="m18 2 4 4-14 14-5 1 1-5L18 2Z"/><path d="m15 5 4 4"/>','Вірші'],
  ['<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>','Листи'],
  ['<rect x="3" y="5" width="18" height="14" rx="4"/><path d="m10 9 5 3-5 3z"/>','YouTube'],
  ['<path d="M3 7V5a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M3 9h18"/>','Сімейний архів'],
];
const steps = [
  ['01','Консультація та концепція','Обговорюємо побажання, підбираємо форму, матеріал та художнє оформлення.'],
  ['02','Створення та встановлення','Виготовляємо, гравіюємо та професійно встановлюємо на місці.'],
  ['03','Активація цифрової сторінки','Створюємо сторінку пам’яті та розміщуємо QR-код на пам’ятнику.'],
];
---
<GravisLayout>
  <header class="g-header"><a class="g-brand" href={`${basePath}/`} aria-label="Gravis — на головну"><span class="g-mark">G<i></i></span><span>Gravis</span></a><nav aria-label="Головна навігація"><a href="#services">Послуги</a><a href="#process">Про нас</a><a href="#services">Наші роботи</a><a href={`${basePath}/memory/oleksandr-kovalenko`}>Сторінки пам’яті</a><a href={`${basePath}/memory/oleksandr-kovalenko#media`}>Медіа</a><a href="#contact">Контакти</a></nav><div class="g-header-actions"><span class="g-locale" aria-label="Мова сайту: українська">◎ <span>UA</span></span><a class="g-header-cta" href="#contact">Залишити заявку <span>→</span></a><button class="g-menu" aria-label="Відкрити меню" aria-expanded="false">☰</button></div></header>
  <main>
    <section class="g-hero">
      <img class="g-hero-photo" src={`${basePath}/images/monument-hero.webp`} alt="Гранітний пам’ятник із QR-табличкою у тихому природному оточенні" />
      <div class="g-hero-shade"></div>
      <div class="g-hero-copy wrap"><p class="g-kicker">БІЛЬШЕ НІЖ ПАМ’ЯТНИК</p><h1>Пам’ять,<br/>закарбована в камені</h1><p class="g-intro">Gravis створює пам’ятники з граніту, художнє оформлення, встановлення та цифрові сторінки пам’яті, де найважливіше житиме поруч — сьогодні й для наступних поколінь.</p><div class="g-actions"><a class="g-button" href="#services">Обрати пам’ятник <span>→</span></a><a class="g-button outline" href="#contact">Консультація фахівця</a></div><div class="g-proof"><span><b>◇</b> Натуральний<br/>граніт преміум-якості</span><span><b>♢</b> Гарантія<br/>та професійне встановлення</span><span><b>▦</b> Сучасні технології<br/>для вічної пам’яті</span></div></div>
    </section>
    <section class="g-services g-section" id="services"><div class="wrap"><div class="g-section-head"><div class="g-heading-row"><h2>Наші послуги</h2><span class="g-rule"></span><a href="#contact">Усі послуги <span>→</span></a></div><p>Комплексний підхід до створення місця пам’яті, яке поєднує традиції, майстерність і сучасні технології.</p></div><div class="g-service-grid">{services.map(([title,desc],i)=><a class="g-service" href="#contact"><div class="g-service-image"><img src={`${basePath}/images/services.webp`} alt={title} loading="lazy" style={`--tile-x:${i%3};--tile-y:${Math.floor(i/3)}`}/></div><div class="g-service-copy"><h3>{title}</h3><p>{desc}</p></div><span class="g-round-arrow" aria-hidden="true">→</span></a>)}</div></div></section>
    <section class="g-archive" id="approach" style={`--archive-image:url("${basePath}/images/monument-hero.webp")`}><div class="wrap g-archive-layout"><div><h2>Що можна зберегти<br/>на сторінці пам’яті</h2><p>Цифрова сторінка пам’яті — це особистий простір, де живуть спогади, важливі моменти та голоси найближчих.</p></div><div class="g-archive-grid">{capabilities.map(([icon,label])=><div class="g-archive-item"><span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icon}></svg></span><small>{label}</small></div>)}</div></div></section>
    <section class="g-process" id="process"><div class="wrap"><div class="g-process-head"><h2>Як це працює</h2><p>Від першої розмови до збереження найцінніших спогадів.</p></div><div class="g-steps"><div class="g-step-rule" aria-hidden="true"></div>{steps.map(([number,title,desc],i)=><article class="g-step"><span class="g-step-number">{number}</span><div class="g-step-image"><img src={`${basePath}/images/process.webp`} alt={title} loading="lazy" style={`--tile-x:${i};--tile-y:0`}/></div><h3>{title}</h3><p>{desc}</p></article>)}</div></div></section>
    <section class="g-bridge"><div class="wrap g-bridge-layout"><div class="g-bridge-copy"><h2>Приклад сторінки пам’яті</h2><p>Діліться спогадами. Зберігайте історію. Будьте поруч, навіть коли фізично далеко.</p><a class="g-button" href={`${basePath}/memory/oleksandr-kovalenko`}>Відкрити сторінку пам’яті <span>→</span></a></div><a class="g-phone" href={`${basePath}/memory/oleksandr-kovalenko`} aria-label="Відкрити сторінку пам’яті Олександра Коваленка"><img src={`${basePath}/images/portrait.webp`} alt="Портрет Олександра на сторінці пам’яті" loading="lazy"/></a><div class="g-bridge-note"><h3>Більше, ніж спогади</h3><p>Сторінка пам’яті — це можливість зберегти голос, важливі моменти, сімейні історії та все, що робить людину особливою. Доступна з будь-якого пристрою, у будь-якій точці світу.</p></div></div></section>
    <footer class="g-footer" id="contact"><div class="wrap g-footer-grid"><div class="g-footer-brand"><a class="g-brand" href={`${basePath}/`}><span class="g-mark">G<i></i></span><span>Gravis</span></a><p>Створюємо місця пам’яті,<br/>які залишаються з нами назавжди.</p></div><div class="g-footer-contacts"><h3>Контакти</h3><a href="tel:+380671234567">⌕ &nbsp; +380 67 123 45 67</a><a href="mailto:info@gravis.ua">✉ &nbsp; info@gravis.ua</a><p>⌖ &nbsp; м. Київ, вул. Гранітна, 12</p><p>◷ &nbsp; Пн — Сб: 9:00 — 18:00</p></div><div class="g-footer-cta"><h2>Обговоримо<br/>ваш проєкт?</h2><p>Допоможемо підібрати найкраще рішення та відповімо на всі питання.</p><a class="g-button" href="mailto:info@gravis.ua?subject=Консультація%20Gravis">Залишити заявку <span>→</span></a></div></div><div class="wrap g-legal"><small>© 2026 Gravis. Всі права захищені.</small><div><a href={`${basePath}/sitemap.xml`}>Карта сайту</a></div></div></footer>
  </main>
  <script>
    const menu=document.querySelector('.g-menu');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));document.querySelector('.g-header nav')?.classList.toggle('nav-open',open)});
  </script>
</GravisLayout>


