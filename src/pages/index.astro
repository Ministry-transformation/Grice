---
import GravisLayout from '../layouts/GravisLayout.astro';
import { services } from '../data/services';
import { monumentOrderFormUrl } from '../data/contact';
import { localAreaCopy } from '../data/seo';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeFaqs = [
  { question: 'Де ви виготовляєте та встановлюєте пам’ятники?', answer: 'Майстерня Gravis знаходиться у Крижополі. Виїзди до сусідніх населених пунктів Вінницької області, орієнтовно в межах 30–50 км, потрібно погодити телефоном.' },
  { question: 'Які пам’ятники можна замовити?', answer: 'Можна обговорити гранітні й бетонні пам’ятники, форму, художнє оформлення, портрет і напис. Конкретні матеріали, наявність і склад робіт підтверджуються до замовлення.' },
  { question: 'Як отримати прорахунок?', answer: 'Залиште коротку заявку, щоб зв’язатися з майстернею, або заповніть детальну Google Форму з параметрами майбутнього пам’ятника.' },
  { question: 'Скільки років Gravis працює у цій сфері?', answer: 'Підприємство має понад 25 років досвіду у виготовленні, художньому оформленні та встановленні пам’ятників.' },
];
const capabilities = [
  ['<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>','Фото'],
  ['<circle cx="12" cy="12" r="9"/><path d="m10 8 6 4-6 4z"/>','Відео'],
  ['<path d="M2 12h3l2-7 4 14 3-10 2 3h6"/>','Аудіо'],
  ['<rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0M12 19v3m-4 0h8"/>','Голос'],
  ['<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/>','Історія життя'],
  ['<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/>','Спогади'],
  ['<path d="m18 2 4 4-14 14-5 1 1-5L18 2Z"/><path d="m15 5 4 4"/>','Вірші'],
  ['<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>','Листи'],
  ['<rect x="3" y="5" width="18" height="14" rx="4"/><path d="m10 9 5 3-5 3z"/>','YouTube'],
  ['<path d="M3 7V5a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M3 9h18"/>','Сімейний архів'],
];
const steps = [
  ['01','Консультація та концепція','Обговорюємо побажання, підбираємо форму, матеріал та художнє оформлення.','process-0.webp'],
  ['02','Погодження й виконання','Уточнюємо матеріали, перелік робіт, умови ділянки та вартість до початку.','process-1.webp'],
  ['03','Цифровий формат','Обговорюємо вміст сторінки, формат QR-переходу, доступ і правила зберігання.','process-2.webp'],
];
---
<GravisLayout title="Пам’ятники у Крижополі — гранітні й бетонні | Gravis" description="Виготовлення, художнє оформлення та встановлення гранітних і бетонних пам’ятників у Крижополі й поруч. Понад 25 років досвіду. Телефонуйте: +38 (063) 649-17-14." canonical="/" includeLocalBusiness={true} socialImage="monument-hero.webp" faqs={homeFaqs}>
  <a class="skip-link" href="#main-content">Перейти до змісту</a>
  <header class="g-header"><a class="g-brand" href={`${basePath}/`} aria-label="Gravis — на головну"><span class="g-mark">G<i></i></span><span>Gravis</span></a><nav aria-label="Головна навігація"><a href="#services">Напрямки</a><a href={`${basePath}/monuments`}>Каталог пам’ятників</a><a href={`${basePath}/stones`}>Камінь</a><a href={`${basePath}/works`}>Концепції</a><a href={`${basePath}/memory/oleksandr-kovalenko`}>Сторінка пам’яті · демо</a><a href={`${basePath}/contact`}>Контакт</a></nav><div class="g-header-actions"><span class="g-locale" aria-label="Мова сайту: українська">◎ <span>UA</span></span><a class="g-header-cta" href={`${basePath}/contact#request`}>Коротка заявка <span>→</span></a><button class="g-menu" aria-label="Відкрити меню" aria-expanded="false">☰</button></div></header>
  <main id="main-content">
    <section class="g-hero">
      <picture class="g-hero-picture"><source media="(max-width: 680px)" srcset={`${basePath}/images/monument-hero-mobile.webp`} /><img class="g-hero-photo" src={`${basePath}/images/monument-hero.webp`} alt="Гранітний пам’ятник із QR-табличкою у тихому природному оточенні" /></picture>
      <div class="g-hero-shade"></div>
      <div class="g-hero-copy wrap"><p class="g-kicker">GRAVIS · КРИЖОПІЛЬ · ПОНАД 25 РОКІВ ДОСВІДУ</p><h1>Пам’ять,<br/>закарбована в камені</h1><p class="g-intro">Понад 25 років виготовляємо гранітні й бетонні пам’ятники, виконуємо художнє оформлення та встановлення у Крижополі. {localAreaCopy}</p><div class="g-actions g-order-actions"><a class="g-button" href={`${basePath}/contact#request`}>Залишити коротку заявку <span>→</span></a><a class="g-button outline" href={monumentOrderFormUrl} target="_blank" rel="noopener noreferrer">Детальний прорахунок пам’ятника <span>↗</span></a></div><a class="g-text-link g-catalog-link" href={`${basePath}/monuments`}>Спершу переглянути пам’ятники <span>→</span></a><div class="g-proof"><span><b>◇</b> Гранітні й бетонні<br/>пам’ятники</span><span><b>♢</b> Понад 25 років<br/>досвіду</span><span><b>▦</b> Виготовлення<br/>та встановлення</span></div></div>
    </section>
    <section class="g-services g-section" id="services"><div class="wrap"><div class="g-section-head"><div class="g-heading-row"><h2>Напрямки</h2><span class="g-rule"></span><a href={`${basePath}/contact#request`}>Обговорити проєкт <span>→</span></a></div><p>Оберіть напрямок, щоб переглянути варіанти й підготувати побажання до розмови.</p></div><div class="g-service-grid">{services.map((service)=><a class="g-service" href={`${basePath}/${service.moduleSlug}`} aria-label={`Детальніше: ${service.name}`}><div class="g-service-image"><img src={`${basePath}/images/${service.image}`} alt={service.imageAlt} loading="lazy"/></div><div class="g-service-copy"><h3>{service.name}</h3><p>{service.short}</p></div><span class="g-round-arrow" aria-hidden="true">→</span></a>)}</div><p class="home-extra-links"><a href={`${basePath}/stones`}>Камінь і фактура</a><a href={`${basePath}/works`}>Візуальні концепції</a><a href={`${basePath}/about`}>Підхід до роботи</a><a href={`${basePath}/contact#request`}>Контактна форма</a></p></div></section>
    <section class="g-archive" id="approach" style={`--archive-image:url("${basePath}/images/monument-hero.webp")`}><div class="wrap g-archive-layout"><div><h2>Що може містити<br/>сторінка пам’яті</h2><p>Демо показує, як можна структурувати біографію, архів і спогади. Публікація матеріалів, доступ і зберігання узгоджуються з родиною окремо.</p><a href={`${basePath}/digital-memorial`} class="module-small-link">Про формат і відкриті питання →</a></div><div class="g-archive-grid">{capabilities.map(([icon,label])=><div class="g-archive-item"><span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icon}></svg></span><small>{label}</small></div>)}</div></div></section>
    <section class="g-process" id="process"><div class="wrap"><div class="g-process-head"><h2>Як рухається проєкт</h2><p>Послідовність для обговорення — конкретний обсяг і можливості залежать від погоджених робіт.</p></div><div class="g-steps"><div class="g-step-rule" aria-hidden="true"></div>{steps.map(([number,title,desc,image])=><article class="g-step"><span class="g-step-number">{number}</span><div class="g-step-image"><img src={`${basePath}/images/${image}`} alt={title} loading="lazy"/></div><h3>{title}</h3><p>{desc}</p></article>)}</div></div></section>
    <section class="module-faq wrap" aria-labelledby="home-faq-title"><div class="module-title"><p class="g-kicker dark">ВІДПОВІДІ</p><h2 id="home-faq-title">Часті запитання</h2></div><div>{homeFaqs.map((faq) => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div></section>
    <section class="g-bridge"><div class="wrap g-bridge-layout"><div class="g-bridge-copy"><h2>Демо сторінки пам’яті</h2><p>Приклад структури й взаємодій. Біографія, голос і світлини тут демонстраційні — перед публікацією потрібні матеріали й згода родини.</p><a class="g-button" href={`${basePath}/memory/oleksandr-kovalenko`}>Відкрити демо <span>→</span></a></div><a class="g-phone" href={`${basePath}/memory/oleksandr-kovalenko`} aria-label="Відкрити демо сторінки пам’яті"><img src={`${basePath}/images/portrait.webp`} alt="Демонстраційний портрет у прикладі сторінки пам’яті" loading="lazy"/></a><div class="g-bridge-note"><h3>Формат для обговорення</h3><p>Склад сторінки, дозвіл на матеріали, приватність і строк зберігання потрібно погодити до запуску.</p><a class="module-small-link" href={`${basePath}/digital-memorial`}>Детальніше про формат →</a></div></div></section>
    <footer class="g-footer" id="contact"><div class="wrap g-footer-grid"><div class="g-footer-brand"><a class="g-brand" href={`${basePath}/`}><span class="g-mark">G<i></i></span><span>Gravis</span></a><p>Понад 25 років у справі.<br/>Виготовлення та встановлення пам’ятників.</p><div class="g-footer-direct"><a href="tel:+380636491714">+38 (063) 649-17-14</a><a href="tel:+380679186814">+38 (067) 918-68-14</a><a href="mailto:mega-gospodar@meta.ua">mega-gospodar@meta.ua</a><a href="https://www.google.com/maps/search/?api=1&query=Крижопіль%2C%20вулиця%20Данила%20Нечая%2031-А" target="_blank" rel="noopener noreferrer">Крижопіль, вул. Данила Нечая, 31-А ↗</a></div></div><div class="g-footer-contacts"><h3>Напрямки</h3><a href={`${basePath}/monuments`}>Гранітні й бетонні пам’ятники</a><a href={`${basePath}/artwork`}>Художнє оформлення</a><a href={`${basePath}/installation`}>Встановлення</a><a href={`${basePath}/digital-memorial`}>Цифрова сторінка пам’яті</a></div><div class="g-footer-cta"><h2>Обговоримо<br/>ваш задум?</h2><p>Оберіть коротку заявку або детально опишіть замовлення пам’ятника.</p><div class="g-footer-actions"><a class="g-button" href={`${basePath}/contact#request`}>Коротка заявка <span>→</span></a><a class="g-button outline" href={monumentOrderFormUrl} target="_blank" rel="noopener noreferrer">Детальний прорахунок <span>↗</span></a></div></div></div><div class="wrap g-legal"><small>© {new Date().getFullYear()} Gravis · Крижопіль</small><div><a href={`${basePath}/sitemap.xml`}>Карта сайту</a></div></div></footer>
  </main>
  <script>
    const menu=document.querySelector<HTMLButtonElement>('.g-menu');const pageNav=document.querySelector<HTMLElement>('.g-header nav');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));menu.setAttribute('aria-label',open?'Закрити меню':'Відкрити меню');pageNav?.classList.toggle('nav-open',open)});pageNav?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{menu?.setAttribute('aria-expanded','false');menu?.setAttribute('aria-label','Відкрити меню');pageNav.classList.remove('nav-open')}));
  </script>
</GravisLayout>


